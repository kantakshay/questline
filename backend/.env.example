PORT=4000

NODE_ENV=development

# Local Postgres from docker-compose.
# Production (Neon): postgres://USER:PASS@ep-xxx.neon.tech/questline?sslmode=verify-full
#   sslmode in the URL overrides DATABASE_SSL / DATABASE_SSL_CA below. Use verify-full,
#   not require: pg warns that require will stop checking the certificate in pg v9.
DATABASE_URL=postgres://questline:questline@localhost:5432/questline
# Only for hosts without sslmode in the URL (e.g. Aurora with the RDS CA bundle).
DATABASE_SSL=false
DATABASE_SSL_CA=

# Production: https://git.questline.io
GITEA_BASE_URL=http://localhost:3001
# Gitea service-account token (Settings → Applications → Generate Token)
GITEA_API_TOKEN=
# Same secret as the "Secret" field on the Gitea webhook
GITEA_WEBHOOK_SECRET=
# Gitea login of the final approver: gets the admin role on sign-in
GITEA_ADMIN_LOGIN=

# Sign in with Gitea: Gitea → Site Administration → Integrations → Applications
# (or user Settings → Applications) → "Create a new OAuth2 Application", confidential client.
# Its Redirect URI must equal GITEA_OAUTH_REDIRECT_URL exactly.
GITEA_OAUTH_CLIENT_ID=
GITEA_OAUTH_CLIENT_SECRET=
# Production: https://api.questline.io/auth/gitea/callback
GITEA_OAUTH_REDIRECT_URL=http://localhost:4000/auth/gitea/callback

# The frontend allowed to call the API with cookies. Production: https://app.questline.io
FRONTEND_URL=http://localhost:5173
# Secure (HTTPS-only) cookies. Defaults to true when NODE_ENV=production.
COOKIE_SECURE=false
